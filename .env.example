# ── AI ──────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Gmail ───────────────────────────────────────────────────────────────
# Path to the OAuth2 credentials JSON downloaded from Google Cloud Console
GMAIL_CREDENTIALS_PATH=./gmail_credentials.json
# Where to store the access token after first auth
GMAIL_TOKEN_PATH=./gmail_token.json
# Your Gmail address (used as From: header)
GMAIL_FROM_ADDRESS=you@gmail.com

# ── Database ─────────────────────────────────────────────────────────────
# SQLite (default — no setup needed)
DATABASE_URL=sqlite:///./jobpilot.db
# Or PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/jobpilot

# ── Backend ──────────────────────────────────────────────────────────────
# Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=http://localhost:3000

# ── Dashboard ────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
