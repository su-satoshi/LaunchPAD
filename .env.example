# ── AI ──────────────────────────────────────────────────────────────────
# The only API key you need. Powers matching, drafting and the browser agent.
ANTHROPIC_API_KEY=sk-ant-...

# ── Self-hosted Firecrawl (docker compose up -d) ────────────────────────
FIRECRAWL_URL=http://localhost:3002
# Only if you point at a Firecrawl instance that needs one; the bundled stack doesn't
FIRECRAWL_API_KEY=
FIRECRAWL_MAX_QUERIES=8
FIRECRAWL_RESULTS_PER_QUERY=6
# Pin / upgrade the Firecrawl release built by docker-compose.yml
FIRECRAWL_REF=v2.11.498

# ── Stagehand browser agent (runs locally, no Browserbase account) ──────
STAGEHAND_MODEL=anthropic/claude-sonnet-4-6
# Chrome profile the agent uses; your forum sign-ins are saved here
BROWSER_PROFILE_DIR=./.browser-data
# Leave empty to auto-detect Google Chrome
CHROME_PATH=
# Searching runs headless; posting opens a visible window so you can watch
AGENT_HEADLESS=true
POST_HEADLESS=false
# Careers sites the agent visits per search run
AGENT_MAX_SITES=6

# ── Gmail ───────────────────────────────────────────────────────────────
GMAIL_CREDENTIALS_PATH=./gmail_credentials.json
GMAIL_TOKEN_PATH=./gmail_token.json
GMAIL_FROM_ADDRESS=you@gmail.com

# ── Database ─────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./jobpilot.db

# ── Backend / dashboard ──────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
